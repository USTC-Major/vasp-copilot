# Golden artifacts are compared byte-for-byte across operating systems.
backend/tests/be_a/golden/** text eol=lf
backend/tests/be_a/golden/**/*.zip binary
# The checksum manifest is generated for canonical release archive bytes.
SHA256SUMS.txt text eol=lf

# Recipe provenance hashes the exact YAML bytes read from this checkout.
backend/app/recipes/packs/vasp_mvp_core/**/*.yaml text eol=lf
backend/app/recipes/packs/vasp_mvp_core/pack.yaml text eol=lf

# Desktop assets whose exact bytes are checked during build.
desktop/assets/app-icon.svg text eol=lf
desktop/assets/app-icon.png binary
desktop/assets/app-icon.ico binary
# Preserve upstream license bytes, including their original trailing spaces.
desktop/licenses/WebView2-LICENSE.txt -text -whitespace
desktop/licenses/WebView2-NOTICE.txt -text -whitespace

# Public energy fixtures retain the upstream bytes verified by SHA-256.
backend/tests/fixtures/energy/OUTCAR* -text
