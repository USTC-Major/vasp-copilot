# ===== VASP-Doctor 后端运行配置示例 =====
# 复制为 .env 后按需修改；留空/未配置项使用代码内默认值。
# LLM 相关默认关闭，符合设计方案：LLM/Agent 为可选项、默认关闭。

# --- 运行时 / 存储 ---
# 诊断记录按 TTL 在内存中自动过期（设计方案：本地 session + TTL 临时文件）
TTL_SECONDS=86400

# --- 上传与安全边界（对应设计方案安全阈值） ---
MAX_UPLOAD_BYTES=209715200            # 上传压缩包上限 200MB
MAX_UNCOMPRESSED_BYTES=1572864000     # 解压后总大小上限 1.5GB
MAX_FILE_COUNT=2000                   # 单个压缩包最多文件数
MAX_UNCOMPRESSION_RATIO=100.0         # 压缩比上限（防 zip bomb）

# --- 预览 / 证据（对齐设计 6.2） ---
MAX_PREVIEW_BYTES=524288              # 普通文本预览最大字节数 512KiB
MAX_PREVIEW_LINES=1000                # 普通文本预览最大行数
MAX_OUTCAR_PREVIEW_LINES=500          # OUTCAR 预览上限（仅 head/tail/range，禁止翻页下载全文）
MAX_EVIDENCE_EXCERPT=512              # 证据摘录最大字符数

# --- 特性开关 ---
# ENABLE_BAND=false
# ENABLE_POTCAR_CONCAT=false
# 孤儿 run 目录清扫（默认关闭：保留历史 diag_* run 数据；需回收磁盘时再开启）
# ORPHAN_RUN_CLEANUP=false

# --- LLM 解释（可选，默认关闭；启用需配置 base_url 与 api_key） ---
ENABLE_LLM=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# --- CORS（13.2：前端跨域白名单，逗号分隔；默认本地 Vite 开发端口）---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- 数据目录（Docker/Compose 部署时指向挂载卷）---
DATA_DIR=data
