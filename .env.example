# ===== VASP-Doctor 根目录环境变量示例（13.2 交付物）=====
# 复制为 .env 后按需修改；留空未配置项使用代码内默认值。
# 本文件只包含无秘密默认值与注释；真实 API key 不要提交到仓库。

# --- 运行 / 存储 ---
DATA_DIR=data                       # 诊断临时目录（runs 等）；Docker 部署可指向挂载卷
TTL_SECONDS=86400                   # 诊断记录 TTL（内存/磁盘自动过期清理）

# --- 上传与安全边界（安全阈值）---
MAX_UPLOAD_BYTES=209715200           # 上传压缩包上限 200MB
MAX_UNCOMPRESSED_BYTES=1572864000    # 解压后总大小上限 1.5GB
MAX_FILE_COUNT=2000                  # 单个压缩包最多文件数
MAX_UNCOMPRESSION_RATIO=100.0        # 压缩比上限（防 zip bomb）

# --- 预览 / 证据（对齐设计 6.2）---
MAX_PREVIEW_BYTES=524288             # 普通文本预览最大字节数 512KiB
MAX_PREVIEW_LINES=1000               # 普通文本预览最大行数
MAX_OUTCAR_PREVIEW_LINES=500         # OUTCAR 预览上限（仅 head/tail/range）
MAX_EVIDENCE_EXCERPT=512             # 证据摘录最大字符数

# --- 特性开关（7.23 FeatureFlags）---
# ENABLE_BAND=false
# ENABLE_POTCAR_CONCAT=false
# ENABLE_LOCAL_FAKE_HPC=true   # 本地 Fake HPC 桥接（§6.13-6.24 演示适配器；默认开启，设 false 整体关闭）

# --- CORS（13.2：前端跨域白名单，逗号分隔；默认本地 Vite 开发端口）---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM 解释（可选，默认关闭；启用需配置 base_url 与 api_key）---
ENABLE_LLM=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# --- Materials Project 数据库接入（可选）---
# MP_API_KEY=your_materials_project_api_key   # 在 materialsproject.org/docs API 获取
# ENABLE_MATERIALS_PROJECT=true              # 显式开放搜索；退出权限最小化
# --- Toolbox 执行服务（8000；不依赖 ENABLE_AI_MODE 或模型 key）---
#VASP_AI_HOME=/data/app/ai_mode             # 兼容数据根；execution_store.json 与 chat_store.json 分开写入
#TOOLBOX_URL=http://127.0.0.1:8000          # 8500 客户端访问地址；Compose 中为 http://backend:8000
# 每个服务使用单 worker；8000 独占执行记录与监控，8500 只写聊天记录。
# 首次启动只读导入旧 ai_store.json；保留原文件，不自动重放旧待确认/未知提交。
# 执行配置使用 toolbox_config.json，兼容旧 AI_MODE_* 环境变量；不需要 LLM 配置。

# --- AI 智能模式（backend/ai_mode，端口 8500；ENABLE_AI_MODE=true 时启用）---
# 模型变量优先级：代码默认 < ~/.vasp-ai/ai_config.json（不存在时只读回退旧config.json）< 环境变量。
# 未配置 LLM key 时 AI_MODE_LLM_PROVIDER=auto 会自动降级为 fake 演示模式，
# fake 模型不代表 Fake HPC，也不代表真实任务已提交。SSH 密码存系统凭据管理器，不落本文件。

#ENABLE_AI_MODE=true                        # 智能模式总开关（默认 false）

#AI_MODE_MAX_JOBS=20                        # 同时进行作业数上限
#AI_MODE_POLL_INTERVAL_SECONDS=60           # 作业监控轮询间隔（10~3600 秒，默认 60）
#AI_MODE_BILLING_ESTIMATE_ENABLED=false     # 计费估算开关

#AI_MODE_LLM_PROVIDER=auto                  # fake | openai | auto（auto：有 key 走 openai，否则 fake）
#AI_MODE_LLM_BASE_URL=https://api.openai.com/v1   # 任意 OpenAI-compatible 端点
#AI_MODE_LLM_API_KEY=                       # 真实密钥只写本地 .env，勿提交仓库
#AI_MODE_LLM_MODEL=gpt-4o-mini
#AI_MODE_LLM_TIMEOUT_SECONDS=120
#AI_MODE_LLM_MAX_RETRIES=2
#AI_MODE_LLM_MAX_TOKENS=1024
#AI_MODE_LLM_TEMPERATURE=0.2
#AI_MODE_LLM_ENABLE_THINKING=false          # 推理模型需显式开启思考时设 true（兼容 delta.reasoning_content）

#AI_MODE_SSH_NAME=                          # 超算连接名（展示用）
#AI_MODE_SSH_HOST=                          # 超算登录节点
#AI_MODE_SSH_PORT=22
#AI_MODE_SSH_USERNAME=
#AI_MODE_SSH_KNOWN_HOSTS_PATH=              # 后端本机 known_hosts 路径；未知/变化的主机密钥拒绝连接
#AI_MODE_SSH_IDENTITY_FILE=                 # 后端本机私钥绝对路径（可选）；指定后不回退到密码/agent；不支持口令加密密钥
#AI_MODE_SCHEDULER_BACKEND=slurm            # slurm | paracloud；按实际平台选择，不按命令是否存在自动猜测
# 注意：SSH 密码不经环境变量配置——在设置页保存到系统凭据管理器（keyring：
# Windows 凭据管理器 / macOS 钥匙串开箱即用；Linux 无桌面环境需可用 keyring 后端）。

#AI_MODE_MP_API_KEY=                        # Materials Project API key（可选）
