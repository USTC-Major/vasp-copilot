# ===== VASP-Doctor 根目录环境变量示例（13.2 交付物）=====
# 复制为 .env 后按需修改；留空未配置项使用代码内默认值。
# 本文件只包含无秘密默认值与注释；真实 API key 不要提交到仓库。

# --- 运行 / 存储 ---
DATA_DIR=data                       # 诊断临时目录（runs 等）；Docker 部署可指向挂载卷
TTL_SECONDS=86400                   # 诊断记录 TTL（内存/磁盘自动过期清理）

# --- 上传与安全边界（安全阈值）---
MAX_UPLOAD_BYTES=209715200           # 上传压缩包上限 200MB
MAX_UNCOMPRESSED_BYTES=1572864000    # 解压后总大小上限 1.5GB
MAX_FILE_COUNT=2000                  # 单个压缩包最多文件数
MAX_UNCOMPRESSION_RATIO=100.0        # 压缩比上限（防 zip bomb）

# --- 预览 / 证据（对齐设计 6.2）---
MAX_PREVIEW_BYTES=524288             # 普通文本预览最大字节数 512KiB
MAX_PREVIEW_LINES=1000               # 普通文本预览最大行数
MAX_OUTCAR_PREVIEW_LINES=500         # OUTCAR 预览上限（仅 head/tail/range）
MAX_EVIDENCE_EXCERPT=512             # 证据摘录最大字符数

# --- 特性开关（7.23 FeatureFlags）---
# ENABLE_BAND=false
# ENABLE_POTCAR_CONCAT=false
# ENABLE_LOCAL_FAKE_HPC=true   # 本地 Fake HPC 桥接（§6.13-6.24 演示适配器；默认开启，设 false 整体关闭）

# --- CORS（13.2：前端跨域白名单，逗号分隔；默认本地 Vite 开发端口）---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM 解释（可选，默认关闭；启用需配置 base_url 与 api_key）---
ENABLE_LLM=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# --- Materials Project 数据库接入（可选）---
# MP_API_KEY=your_materials_project_api_key   # 在 materialsproject.org/docs API 获取
# ENABLE_MATERIALS_PROJECT=true              # 显式开放搜索；退出权限最小化